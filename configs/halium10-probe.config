# Configuration probe for the observed Android 10 / VNDK 29 vendor base.
# Requires AppArmor source patches, real board data and device validation.
CONFIG_NAMESPACES=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_DEVTMPFS=y
CONFIG_VT=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
# CONFIG_HW_CGROUP_PIDS is not set
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# CONFIG_DEFAULT_SECURITY_SELINUX is not set
CONFIG_DEFAULT_SECURITY="apparmor"
